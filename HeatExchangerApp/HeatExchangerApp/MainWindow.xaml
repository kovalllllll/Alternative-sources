<Window x:Class="HeatExchangerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторна робота 4 — Розрахунок теплообмінника"
        Height="680" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Розрахунок теплообмінника"
                   FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1"
                   Text="Варіант 8: F=1000 м², Th_вх=150°C, Tc_вх=50°C"
                   FontSize="12" Foreground="#666"
                   HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <!-- Вхідні параметри -->
        <GroupBox Grid.Row="2" Header="Вхідні параметри" Margin="0,0,0,10"
                  Background="White">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0" Margin="5">
                    <TextBlock Text="F, м²:" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtF" Text="1000" Padding="4"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="5">
                    <TextBlock Text="K, ккал/(м²·год·°C):" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtK" Text="70" Padding="4"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.Row="0" Margin="5">
                    <TextBlock Text="Th_вх, °C:" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtThIn" Text="150" Padding="4"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Grid.Row="0" Margin="5">
                    <TextBlock Text="Tc_вх, °C:" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtTcIn" Text="50" Padding="4"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1" Margin="5">
                    <TextBlock Text="Gh, т/год:" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtGh" Text="98" Padding="4"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="1" Margin="5">
                    <TextBlock Text="Ch, ккал/(кг·°C):" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtCh" Text="0.74" Padding="4"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.Row="1" Margin="5">
                    <TextBlock Text="Gc, т/год:" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtGc" Text="100" Padding="4"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Grid.Row="1" Margin="5">
                    <TextBlock Text="Cc, ккал/(кг·°C):" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtCc" Text="0.55" Padding="4"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Кнопка -->
        <Button Grid.Row="3" Content="▶  Розрахувати"
                Click="BtnCalculate_Click"
                Width="220" Height="38" Margin="0,0,0,12"
                Background="#1565C0" Foreground="White"
                FontSize="14" FontWeight="Bold" Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="5" Padding="10,5">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Результати -->
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="🔵 Прямотік"
                      Margin="0,0,5,0" Background="White">
                <StackPanel Margin="10">
                    <TextBlock x:Name="lblP_ThOut" Text="Th_вих: —"
                               FontSize="13" Margin="0,3"/>
                    <TextBlock x:Name="lblP_TcOut" Text="Tc_вих: —"
                               FontSize="13" Margin="0,3"/>
                    <TextBlock x:Name="lblP_Q"     Text="Q: —"
                               FontSize="13" Margin="0,3"/>
                    <TextBlock x:Name="lblP_DT"    Text="ΔTлог: —"
                               FontSize="13" Margin="0,3"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="🔴 Протитік"
                      Margin="5,0,5,0" Background="White">
                <StackPanel Margin="10">
                    <TextBlock x:Name="lblC_ThOut" Text="Th_вих: —"
                               FontSize="13" Margin="0,3"/>
                    <TextBlock x:Name="lblC_TcOut" Text="Tc_вих: —"
                               FontSize="13" Margin="0,3"/>
                    <TextBlock x:Name="lblC_Q"     Text="Q: —"
                               FontSize="13" Margin="0,3"/>
                    <TextBlock x:Name="lblC_DT"    Text="ΔTлог: —"
                               FontSize="13" Margin="0,3"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="📊 Порівняння"
                      Margin="5,0,0,0" Background="#FFF8E1">
                <StackPanel Margin="10">
                    <TextBlock x:Name="lblCmpFCounter"
                               Text="F протитоку (той самий Q): —"
                               FontSize="12" TextWrapping="Wrap" Margin="0,3"/>
                    <TextBlock x:Name="lblCmpReduction"
                               Text="Зменшення площі: —"
                               FontSize="14" FontWeight="Bold"
                               Foreground="#C62828" Margin="0,8,0,0"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Таблиця дослідження -->
        <GroupBox Grid.Row="5" Header="Дослідження залежності вихідних температур від площі F" Background="White">
            <DataGrid x:Name="dgResults"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      AlternatingRowBackground="#F3F4F6"
                      GridLinesVisibility="Horizontal"
                      Margin="5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="F, м²"         Binding="{Binding F}"         Width="70"/>
                    <DataGridTextColumn Header="Прямотік Th_вих°C" Binding="{Binding P_ThOut}"  Width="130"/>
                    <DataGridTextColumn Header="Прямотік Tc_вих°C" Binding="{Binding P_TcOut}"  Width="130"/>
                    <DataGridTextColumn Header="Протитік Th_вих°C" Binding="{Binding C_ThOut}"  Width="130"/>
                    <DataGridTextColumn Header="Протитік Tc_вих°C" Binding="{Binding C_TcOut}"  Width="130"/>
                    <DataGridTextColumn Header="ΔQ, %"         Binding="{Binding DeltaQ}"    Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>
