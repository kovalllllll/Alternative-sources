<Window x:Class="RankineReheatCycle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Цикл Ренкіна з вторинним перегрівом" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Розрахунок ККД циклу Ренкіна з вторинним перегрівом" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <GroupBox Grid.Row="1" Header="Вхідні параметри" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Базові параметри циклу:" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="P₁ (МПа):" Width="150"/>
                        <TextBox x:Name="txtP1" Width="100" Text="11" IsReadOnly="True" Background="LightGray"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="t₁ (°C):" Width="150"/>
                        <TextBox x:Name="txtT1" Width="100" Text="500" IsReadOnly="True" Background="LightGray"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="P₂ (МПа):" Width="150"/>
                        <TextBox x:Name="txtP2" Width="100" Text="0.004" IsReadOnly="True" Background="LightGray"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="P' (МПа):" Width="150"/>
                        <TextBox x:Name="txtPReheat" Width="100" Text="3" IsReadOnly="True" Background="LightGray"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Параметр, що варіюється :" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="t' базове (°C):" Width="150"/>
                        <TextBox x:Name="txtTReheatBase" Width="100" Text="500"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Зміна (±%):" Width="150"/>
                        <TextBox x:Name="txtVariation" Width="100" Text="20"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Кількість точок:" Width="150"/>
                        <TextBox x:Name="txtPoints" Width="100" Text="21"/>
                    </StackPanel>
                    
                    <Button Content="Розрахувати" Width="150" Height="35" Margin="0,20,0,0"
                            Click="CalculateButton_Click" FontSize="14" FontWeight="Bold"
                            Background="#FF4CAF50" Foreground="White"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Графік залежності ККД від t'" Margin="0,0,10,0">
                <oxy:PlotView x:Name="plotView" Margin="10"/>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Результати розрахунку">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <DataGrid x:Name="dgResults" AutoGenerateColumns="False" 
                                  IsReadOnly="True" Height="300" Margin="0,0,0,10"
                                  AlternatingRowBackground="LightGray">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="t' (°C)" Binding="{Binding TReheat, StringFormat=F2}" Width="*"/>
                                <DataGridTextColumn Header="ККД (%)" Binding="{Binding Efficiency, StringFormat=F3}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="0,10,0,10">
                            <StackPanel>
                                <TextBlock Text="Порівняння з циклом Карно:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock x:Name="txtCarnotComparison" TextWrapping="Wrap" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <Border BorderBrush="Green" BorderThickness="2" Padding="5" Background="LightGreen">
                            <StackPanel>
                                <TextBlock Text="Оптимальне значення:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock x:Name="txtOptimal" TextWrapping="Wrap" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="3" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Готовий до розрахунку"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
